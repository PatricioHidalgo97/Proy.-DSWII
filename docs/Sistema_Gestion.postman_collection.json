{
  "info": {
    "name": "Sistema de Gestión - API completa",
    "description": "Colección académica. Login guarda JWT. Canje bancario es solo registral y no usa pasarela de pagos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login correcto', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"Admin123*\"\n}" }, "url": "{{baseUrl}}/auth/login" }
        }
      ]
    },
    {
      "name": "2. Catálogos",
      "item": [
        { "name": "Crear socio", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('socioId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"SOC-DEMO-01\",\n  \"nombres\": \"María\",\n  \"apellidos\": \"Demostración\",\n  \"accion\": \"A-001\",\n  \"etapa\": 1,\n  \"fechaNacimiento\": \"1990-01-01\",\n  \"activo\": true\n}" }, "url": "{{baseUrl}}/socios" } },
        { "name": "Listar socios", "request": { "method": "GET", "url": "{{baseUrl}}/socios" } },
        { "name": "Crear giro", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('giroId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Comercio Demo\",\n  \"descripcion\": \"Giro de demostración\",\n  \"activo\": true\n}" }, "url": "{{baseUrl}}/giros" } },
        { "name": "Crear puesto", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('puestoId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"numero\": \"P-DEMO-01\",\n  \"nombreInquilino\": \"Inquilino Demo\",\n  \"fechaInicio\": \"2026-08-01\",\n  \"fechaFin\": null,\n  \"socioId\": {{socioId}},\n  \"giroId\": {{giroId}},\n  \"activo\": true\n}" }, "url": "{{baseUrl}}/puestos" } },
        { "name": "Crear banco", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('bancoId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Banco Académico\",\n  \"numeroCuenta\": \"001-DEMO-2026\",\n  \"cci\": \"CCI-DEMO-2026\",\n  \"moneda\": \"PEN\",\n  \"activo\": true\n}" }, "url": "{{baseUrl}}/bancos" } },
        { "name": "Listar bancos", "request": { "method": "GET", "url": "{{baseUrl}}/bancos" } }
      ]
    },
    {
      "name": "3. Servicios y cuentas",
      "item": [
        { "name": "Crear servicio para puesto", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('servicioPuestoId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mantenimiento Demo\",\n  \"recurrencia\": \"MENSUAL\",\n  \"costo\": 80.00,\n  \"moneda\": \"PEN\",\n  \"cargoA\": \"PUESTO\",\n  \"dependeConsumo\": false,\n  \"activo\": true\n}" }, "url": "{{baseUrl}}/servicios" } },
        { "name": "Crear servicio para socio", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('servicioSocioId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Cuota de socio Demo\",\n  \"recurrencia\": \"MENSUAL\",\n  \"costo\": 50.00,\n  \"moneda\": \"PEN\",\n  \"cargoA\": \"SOCIO\",\n  \"dependeConsumo\": false,\n  \"activo\": true\n}" }, "url": "{{baseUrl}}/servicios" } },
        { "name": "Generar cuenta de puesto", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('cuentaPuestoId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-08\",\n  \"puestoId\": {{puestoId}},\n  \"servicioId\": {{servicioPuestoId}},\n  \"monto\": 80.00\n}" }, "url": "{{baseUrl}}/cuentas" } },
        { "name": "Generar cuenta de socio", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('cuentaSocioId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-08\",\n  \"socioId\": {{socioId}},\n  \"servicioId\": {{servicioSocioId}},\n  \"monto\": 50.00\n}" }, "url": "{{baseUrl}}/cuentas" } },
        { "name": "Generar cuentas masivas de puestos", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('cuentaLoteId', pm.response.json()[0].id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"periodo\": \"2026-09\",\n  \"servicioId\": {{servicioPuestoId}},\n  \"puestoIds\": [{{puestoId}}]\n}" }, "url": "{{baseUrl}}/cuentas/generar/puestos" } },
        { "name": "Consultar por socio", "request": { "method": "GET", "url": "{{baseUrl}}/cuentas/socio/{{socioId}}" } },
        { "name": "Pagar cuenta de puesto", "request": { "method": "POST", "url": "{{baseUrl}}/cuentas/{{cuentaPuestoId}}/pagar" } },
        { "name": "Pagar lote", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"cuentaIds\": [{{cuentaLoteId}}]\n}" }, "url": "{{baseUrl}}/cuentas/pagar-lote" } }
      ]
    },
    {
      "name": "4. Tesorería",
      "item": [
        { "name": "Canjear cuenta de socio (simulado)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"cuentaId\": {{cuentaSocioId}},\n  \"bancoId\": {{bancoId}},\n  \"fechaDeposito\": \"{{today}}\"\n}" }, "url": "{{baseUrl}}/cuentas/canjear" } },
        { "name": "Registrar ingreso externo", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"depositante\": \"Visitante Demo\",\n  \"categoria\": \"ALQUILER\",\n  \"concepto\": \"Uso temporal de ambiente\",\n  \"monto\": 120.00\n}" }, "url": "{{baseUrl}}/recibos/externos" } },
        { "name": "Consultar recibos", "request": { "method": "GET", "url": "{{baseUrl}}/recibos?fecha={{today}}" } },
        { "name": "Registrar egreso", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('egresoId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"tipoDocumento\": \"FACTURA\",\n  \"numeroDocumento\": \"F001-500\",\n  \"proveedor\": \"Proveedor Demo\",\n  \"fecha\": \"{{today}}\",\n  \"subtotal\": 100.00,\n  \"impuesto\": 18.00,\n  \"total\": 118.00,\n  \"motivo\": \"Útiles de oficina\",\n  \"documentoAsociado\": \"OC-001\"\n}" }, "url": "{{baseUrl}}/egresos" } },
        { "name": "Procesar egreso", "request": { "method": "PUT", "url": "{{baseUrl}}/egresos/{{egresoId}}/procesar" } },
        { "name": "Listar egresos del mes", "request": { "method": "GET", "url": "{{baseUrl}}/egresos?periodo={{period}}" } }
      ]
    },
    {
      "name": "5. Reportes XLSX",
      "item": [
        { "name": "Movimientos diarios", "request": { "method": "GET", "url": "{{baseUrl}}/reportes/movimientos-diarios?fecha={{today}}" } },
        { "name": "Movimientos mensuales", "request": { "method": "GET", "url": "{{baseUrl}}/reportes/movimientos-mensuales?periodo={{period}}" } },
        { "name": "Padrón de socios", "request": { "method": "GET", "url": "{{baseUrl}}/reportes/socios" } },
        { "name": "Reporte de egresos", "request": { "method": "GET", "url": "{{baseUrl}}/reportes/egresos?periodo={{period}}" } },
        { "name": "Reporte de bancos", "request": { "method": "GET", "url": "{{baseUrl}}/reportes/bancos" } }
      ]
    }
  ],
  "event": [
    { "listen": "prerequest", "script": { "exec": ["const d = new Date();", "const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000);", "pm.collectionVariables.set('today', local.toISOString().slice(0, 10));", "pm.collectionVariables.set('period', local.toISOString().slice(0, 7));"] } }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9090/api" },
    { "key": "token", "value": "" },
    { "key": "today", "value": "2026-08-19" },
    { "key": "period", "value": "2026-08" },
    { "key": "socioId", "value": "" },
    { "key": "giroId", "value": "" },
    { "key": "puestoId", "value": "" },
    { "key": "bancoId", "value": "" },
    { "key": "servicioPuestoId", "value": "" },
    { "key": "servicioSocioId", "value": "" },
    { "key": "cuentaPuestoId", "value": "" },
    { "key": "cuentaSocioId", "value": "" },
    { "key": "cuentaLoteId", "value": "" },
    { "key": "egresoId", "value": "" }
  ]
}
