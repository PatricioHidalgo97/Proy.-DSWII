# api-gateway — variables de entorno (ESP-02 §3)
# Copiar a .env local. Nunca versionar el .env real.

# Puerto del gateway (PORT-GW)
GATEWAY_PORT=9101

# Destinos de los servicios de dominio (ESP-07 §5).
# Estado 1 (PLAN-01): los tres apuntan al monolito porque los servicios todavía
# no exponen endpoints. Cada plan de extracción los mueve a su puerto:
#   PLAN-02 -> IDENTITY_URL=http://localhost:9102
#   PLAN-03 -> CATALOG_URL=http://localhost:9103
#   PLAN-04 -> CASH_URL=http://localhost:9104
IDENTITY_URL=http://localhost:9090
CATALOG_URL=http://localhost:9090
CASH_URL=http://localhost:9090

# Respaldo transitorio al monolito. Se retira en PLAN-05 (ESP-11 §2.2)
MONOLITO_URL=http://localhost:9090

# Origen permitido para CORS (ESP-07 §6)
CORS_ORIGINS=http://localhost:4400
