# api-gateway — variables de entorno (ESP-02 §3)
# Copiar a .env local. Nunca versionar el .env real.

# Puerto del gateway (PORT-GW)
GATEWAY_PORT=9101

# Destinos de los servicios de dominio (ESP-07 §5), Estado 3 de ESP-11 §2.4.
#   PLAN-02 -> IDENTITY_URL=http://localhost:9102
#   PLAN-03 -> CATALOG_URL=http://localhost:9103
#   PLAN-04/05 -> CASH_URL=http://localhost:9104 (cuentas, recibos, egresos y reportes)
IDENTITY_URL=http://localhost:9102
CATALOG_URL=http://localhost:9103
CASH_URL=http://localhost:9104

# MONOLITO_URL quedó retirada en PLAN-05 T-07: la ruta comodín `monolito` ya no
# existe y ninguna ruta del gateway apunta al 9090. Se conserva la nota para que
# nadie la reutilice creyendo que sigue activa. El monolito sigue siendo
# ejecutable como respaldo manual (ESP-11 §9), fuera del gateway.

# Origen permitido para CORS (ESP-07 §6)
CORS_ORIGINS=http://localhost:4400
