# cash-service — variables de entorno (ESP-02 §4)
# Copiar a .env local. Nunca versionar el .env real.

CASH_PORT=9104
DB_PORT=3306
DB_USERNAME=gestion_user
DB_PASSWORD=cambiar-en-local
JWT_SECRET=cambiar-en-produccion
# URL interna de catálogo vista por caja (ESP-02 §3)
CATALOG_URL=http://localhost:9103
# Timeouts del cliente de catálogo (ESP-03 §8): cortos y sin reintentos
CATALOG_CONNECT_TIMEOUT_MS=1500
CATALOG_READ_TIMEOUT_MS=3000
